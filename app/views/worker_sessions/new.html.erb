<div class="card shadow-sm mx-auto" style="max-width:360px">
  <div class="card-body p-4">
    <h5 class="card-title text-center mb-4">Sign in to see worker details</h5>

    <%= form_with url: worker_login_path, method: :post do |f| %>
      <div class="mb-3">
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, class: "form-control", autofocus: true, autocomplete: "username" %>
      </div>
      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
      </div>
      <%= f.submit "Sign in", class: "btn btn-primary w-100" %>
    <% end %>
    <div class="text-center mt-3">
      <%= link_to "← Back to status", worker_root_path, class: "small text-muted" %>
    </div>
  </div>
</div>
