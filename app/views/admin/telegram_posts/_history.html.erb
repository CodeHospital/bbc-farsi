<%= render "admin/shared/filter_group",
      label: "Status", param: :status,
      options: Admin::TelegramPostsController::HISTORY_STATUSES.map { |status| [ status, status.capitalize ] },
      counts: status_counts,
      badge_class: ->(value) { "badge-status-#{value}" } %>

<% if posts.empty? %>
  <div class="alert alert-light border">No posts have been sent yet.</div>
<% else %>
  <table class="table table-hover table-sm">
    <thead>
      <tr>
        <th>Article</th>
        <th><%= sort_link "channel", "Channel" %></th>
        <th><%= sort_link "status", "Status" %></th>
        <th><%= sort_link "posted", "Posted at" %></th>
        <th><%= sort_link "created", "Queued at" %></th>
      </tr>
    </thead>
    <tbody>
      <% posts.each do |post| %>
        <tr>
          <td><%= link_to (post.translation&.translated_title.presence || post.translation&.article&.title).to_s.truncate(80),
                    admin_telegram_post_path(post), class: "text-decoration-none" %></td>
          <td><span class="badge bg-secondary"><%= post.telegram_channel&.display_name %></span></td>
          <td><%= render "admin/shared/status_badge", status: post.status %></td>
          <td><small><%= post.posted_at ? post.posted_at.strftime("%b %d %H:%M") : "failed #{post.updated_at.strftime('%b %d %H:%M')}" %></small></td>
          <td><small><%= post.created_at.strftime("%b %d %H:%M") %></small></td>
        </tr>
        <% if post.error_message.present? %>
          <tr>
            <td colspan="5" class="text-danger small py-0"><%= post.error_message %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <%= render "admin/shared/pagination", pagy: pagy %>
<% end %>
