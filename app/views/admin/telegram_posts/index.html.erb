<h2 class="mb-3">Channel Posts <small class="text-muted fs-6">all providers</small></h2>

<% tab_params = request.query_parameters.slice("channel_id") %>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item">
    <%= link_to admin_telegram_posts_path(tab_params.merge(view: "scheduled")),
          class: "nav-link #{'active' if @view == 'scheduled'}" do %>
      <i class="bi bi-clock"></i> Scheduled <span class="badge bg-secondary"><%= @scheduled_count %></span>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to admin_telegram_posts_path(tab_params.merge(view: "history")),
          class: "nav-link #{'active' if @view == 'history'}" do %>
      <i class="bi bi-clock-history"></i> History <span class="badge bg-secondary"><%= @history_count %></span>
    <% end %>
  </li>
</ul>

<%= form_with url: admin_telegram_posts_path, method: :get, class: "d-flex flex-wrap align-items-center gap-2 mb-3" do %>
  <%= hidden_field_tag :view, @view %>
  <%= hidden_field_tag :status, params[:status] if @view == "history" && params[:status].present? %>
  <label for="channel_id" class="text-muted small">Channel:</label>
  <%= select_tag :channel_id,
        options_from_collection_for_select(@channels, :id, :display_name, @channel_id),
        include_blank: "All channels", class: "form-select form-select-sm", style: "width:auto",
        onchange: "this.form.requestSubmit()" %>
  <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button></noscript>
<% end %>

<% if @view == "scheduled" %>
  <%= render "scheduled", channel_queues: @channel_queues %>
<% else %>
  <%= render "history", posts: @posts, pagy: @pagy, status_counts: @status_counts %>
<% end %>
