<%# AI bias/fact analysis of the original article with an admin edit form.
    Locals: article %>
<div class="card mb-4" id="article_analysis">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>
      <strong>AI analysis</strong> — political leaning &amp; facts vs. speculation
      <% if article.analysis_status.present? %>
        <%= render "admin/shared/status_badge", status: article.analysis_status %>
      <% end %>
    </span>
    <div class="d-flex align-items-center gap-2">
      <% if article.analyzed_at %>
        <small class="text-muted">analyzed <%= article.analyzed_at.strftime("%b %d, %Y %H:%M") %></small>
      <% end %>
      <%= button_to (article.analysis_status.present? ? "↻ Re-analyze" : "Analyze"),
            analyze_admin_article_path(article), method: :post,
            class: "btn btn-sm btn-outline-primary",
            title: "Queue an AI analysis of the original article (overwrites the current values when it finishes)" %>
    </div>
  </div>
  <div class="card-body">
    <div class="mb-3"><%= render "admin/shared/analysis_badges", article: %></div>

    <%= form_with model: article, url: update_analysis_admin_article_path(article), method: :patch do |form| %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Political leaning <small class="text-muted fw-normal">(must add up to 100)</small></label>
          <div class="row g-2">
            <% { bias_left_percent: "Left", bias_center_percent: "Center", bias_right_percent: "Right" }.each do |attribute, label| %>
              <div class="col">
                <div class="input-group input-group-sm">
                  <span class="input-group-text"><%= label %></span>
                  <%= form.number_field attribute, in: 0..100, step: 1, class: "form-control" %>
                  <span class="input-group-text">%</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Content <small class="text-muted fw-normal">(must add up to 100)</small></label>
          <div class="row g-2">
            <% { factual_percent: "Happened (fact)", speculative_percent: "Speculation (future)" }.each do |attribute, label| %>
              <div class="col">
                <div class="input-group input-group-sm">
                  <span class="input-group-text"><%= label %></span>
                  <%= form.number_field attribute, in: 0..100, step: 1, class: "form-control" %>
                  <span class="input-group-text">%</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-12">
          <%= form.label :analysis_reasoning, "Reasoning", class: "form-label fw-semibold" %>
          <%= form.text_area :analysis_reasoning, rows: 2, class: "form-control form-control-sm" %>
        </div>
      </div>
      <%= form.submit "Save analysis", class: "btn btn-sm btn-primary mt-3" %>
    <% end %>
  </div>
</div>
