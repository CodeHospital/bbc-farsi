<%# Article tags: bilingual Tag rows (the first is usually the feed's tag,
    attached when the article was created) that admins and unrestricted
    editors add and remove here and rename on the Tags page. locals: article %>
<% can_edit_tags = current_user.can_edit_tags? %>
<div class="card mb-4" id="tags">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>Tags</strong>
    <%= link_to "Manage all tags →", admin_tags_path, class: "small" %>
  </div>
  <div class="card-body">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <% article_tags = article.ordered_tags %>
      <% article_tags.each do |tag| %>
        <span class="badge rounded-pill <%= tag.missing_translation? ? 'text-bg-warning' : 'text-bg-light border' %> d-inline-flex align-items-center gap-1"
              title="<%= 'Missing a translation — complete it on the Tags page' if tag.missing_translation? %>">
          <span dir="rtl"><%= tag.name_fa || "—" %></span> / <span><%= tag.name_en || "—" %></span>
          <% if can_edit_tags %>
            <%= button_to admin_article_tag_path(article, tag), method: :delete, form_class: "d-inline",
                  class: "btn btn-link btn-sm p-0 ms-1 text-danger", title: "Remove from this article" do %>
              <i class="bi bi-x-circle"></i>
            <% end %>
          <% end %>
        </span>
      <% end %>
      <% if article_tags.empty? %>
        <span class="text-muted small">No tags.</span>
      <% end %>
      <% unless article.tags_generated_at %>
        <span class="text-muted small">AI topic tagging hasn't run yet.</span>
      <% end %>
    </div>

    <% if can_edit_tags %>
      <%= form_with url: admin_article_tags_path(article), method: :post, class: "row g-2 align-items-center" do %>
        <div class="col-md-4">
          <%= text_field_tag :name_fa, nil, class: "form-control form-control-sm", dir: "rtl",
                placeholder: "برچسب فارسی", list: "tag-names-fa", "aria-label": "Persian tag name" %>
        </div>
        <div class="col-md-4">
          <%= text_field_tag :name_en, nil, class: "form-control form-control-sm",
                placeholder: "English tag", list: "tag-names-en", "aria-label": "English tag name" %>
        </div>
        <div class="col-md-2">
          <%= submit_tag "Add tag", class: "btn btn-sm btn-primary" %>
        </div>
        <div class="col-12 form-text">
          Type an existing tag in either language to reuse it (a missing name is filled in), or both names for a new tag.
        </div>
      <% end %>
      <datalist id="tag-names-fa"><% @tag_suggestions.each do |tag| %><% if tag.name_fa %><option value="<%= tag.name_fa %>"><% end %><% end %></datalist>
      <datalist id="tag-names-en"><% @tag_suggestions.each do |tag| %><% if tag.name_en %><option value="<%= tag.name_en %>"><% end %><% end %></datalist>
    <% else %>
      <p class="text-muted small mb-0">Only admins and editors whose edits need no approval can change tags.</p>
    <% end %>
  </div>
</div>
