<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Edit Translation</h2>
  <%= link_to "← Back", admin_translation_path(@translation), class: "btn btn-outline-secondary btn-sm" %>
</div>
<%= render "admin/pending_edits/form_notice", own_pending_edit: @own_pending_edit %>
<% if @translation.article %>
  <div class="card mb-3">
    <div class="card-header">Original source</div>
    <div class="row g-0">
      <% if @article_image_url.present? %>
        <div class="col-md-3">
          <%= image_tag @article_image_url, class: "img-fluid rounded-start", style: "object-fit: cover; height: 100%; width: 100%;" %>
        </div>
      <% end %>
      <div class="col">
        <div class="card-body">
          <h5 class="card-title"><%= @translation.article.title %></h5>
          <p class="card-text text-muted"><%= @translation.article.description %></p>
          <p class="card-text">
            <small class="text-muted">AI analysis:</small>
            <%= render "admin/shared/analysis_badges", article: @translation.article %>
            <%= link_to "edit", admin_article_path(@translation.article, anchor: "article_analysis"), class: "small ms-1" %>
          </p>
          <%= link_to "View original article ↗", @translation.article.url, target: "_blank", rel: "noopener",
                class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
<div class="card mb-3 bg-light">
  <div class="card-body">
    <strong>Rewritten source:</strong> <%= @translation.rewrite&.content&.truncate(300) %>
  </div>
</div>
<%= form_with model: [:admin, @translation] do |f| %>
  <div class="mb-3">
    <%= f.label :translated_title, class: "form-label" %>
    <%= f.text_field :translated_title, class: "form-control", dir: "rtl", lang: "fa" %>
  </div>
  <div class="mb-3">
    <%= f.label :translated_body, class: "form-label" %>
    <%= f.text_area :translated_body, class: "form-control", rows: 12, dir: "rtl", lang: "fa" %>
  </div>
  <%= f.submit (current_user.edits_need_approval? ? "Submit for approval" : "Save"), class: "btn btn-primary" %>
  <%= button_to "↺ Re-translate", rerun_admin_translation_path(@translation), method: :post,
        class: "btn btn-outline-warning ms-2" %>
<% end %>
