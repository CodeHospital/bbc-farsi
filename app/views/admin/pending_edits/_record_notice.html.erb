<%# Shown on Translation/Rewrite show pages when edits to them await review. %>
<% if pending_edits.any? %>
  <div class="alert alert-warning">
    <i class="bi bi-hourglass-split"></i>
    <%= pluralize(pending_edits.size, "edit") %> awaiting approval:
    <% pending_edits.each do |pending_edit| %>
      <%= link_to "by #{pending_edit.author_name} (#{pending_edit.created_at.strftime('%b %d %H:%M')})",
            admin_pending_edit_path(pending_edit), class: "alert-link ms-1" %>
    <% end %>
  </div>
<% end %>
