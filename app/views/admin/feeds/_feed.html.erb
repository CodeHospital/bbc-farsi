<% telegram_posts_counts_by_feed_id ||= {} %>
<% telegram_channel_options ||= [] %>
<tr id="<%= dom_id(feed) %>">
  <td><%= feed.name %>
  <br />
  <span class="badge bg-secondary"><%= feed.category %></span>
  <br />
  <span class="badge bg-info text-dark"><%= feed.source %></span></td>
  <%# Scheme stripped to keep long NYT/BBC feed paths shorter; wraps onto
      multiple lines within the column instead of being clipped. %>
  <td style="max-width: 220px;">
    <small class="text-muted" style="word-break: break-all;" title="<%= feed.url %>"><%= feed.url.sub(%r{\Ahttps?://}, "") %></small>
  </td>
  <% articles_count = feed.articles.count %>
  <td data-sort-value="<%= articles_count %>">
    <%= link_to articles_count, admin_articles_path(feed_id: feed.id) %>
  </td>
  <% telegram_posts_count = telegram_posts_counts_by_feed_id.fetch(feed.id, 0) %>
  <% posted_percentage = articles_count.zero? ? 0 : 100.0 * telegram_posts_count / articles_count %>
  <td data-sort-value="<%= telegram_posts_count %>"><%= telegram_posts_count %></td>
  <td data-sort-value="<%= posted_percentage %>">
    <% unless articles_count.zero? %>
      <span class="badge bg-primary"><%= posted_percentage.round %>%</span>
    <% end %>
  </td>
  <%# Unscheduled feeds sort after every scheduled hour (0-23). %>
  <td data-sort-value="<%= feed.fetch_hour || 99 %>">
    <%= form_with url: schedule_admin_feed_path(feed), method: :patch, class: "d-inline" do %>
      <%= select_tag :fetch_hour,
            options_for_select(
              [ [ "Disabled", "" ] ] + Feed::FETCH_HOURS.map { |hour| [ format("%02d:00", hour), hour ] },
              feed.fetch_hour
            ),
            onchange: "this.form.requestSubmit()",
            class: "form-select form-select-sm", style: "width: auto;",
            aria: { label: "Scheduled fetch hour for #{feed.name}" } %>
    <% end %>
    <% if feed.last_scheduled_fetch_at %>
      <small class="text-muted d-block"><%= time_ago_in_words(feed.last_scheduled_fetch_at) %> ago</small>
    <% end %>
  </td>
  <%# Unassigned feeds sort last (below any channel name). %>
  <td data-sort-value="<%= feed.autopost_channel_label == "Disabled" ? "~" : feed.autopost_channel_label %>">
    <%= form_with url: autopost_channel_admin_feed_path(feed), method: :patch, class: "d-inline" do %>
      <%= select_tag :autopost_telegram_channel_id,
            options_for_select(
              [ [ "Disabled", "" ] ] + telegram_channel_options,
              feed.autopost_telegram_channel_id
            ),
            onchange: "this.form.requestSubmit()",
            class: "form-select form-select-sm", style: "width: auto;",
            aria: { label: "Autopost channel for #{feed.name}" } %>
    <% end %>
    <% if feed.autopost_telegram_channel && !feed.autoposts? %>
      <small class="text-danger d-block">channel not enabled/autoposting</small>
    <% end %>
  </td>
  <td data-sort-value="<%= feed.enabled? ? 1 : 0 %>">
    <%= button_to feed.enabled? ? "Disable" : "Enable",
          toggle_admin_feed_path(feed, request.query_parameters.except("page")), method: :patch,
          class: "btn btn-sm #{feed.enabled? ? 'btn-success' : 'btn-outline-secondary'}" %>
  </td>
  <td>
    <%= button_to "Fetch", fetch_admin_feed_path(feed), method: :post,
          class: "btn btn-sm btn-outline-info me-1" %>
    <%= link_to "Edit", edit_admin_feed_path(feed), class: "btn btn-sm btn-outline-primary me-1" %>
    <%= button_to "Delete", admin_feed_path(feed), method: :delete,
          class: "btn btn-sm btn-outline-danger",
          data: { turbo_confirm: "Delete this feed?" } %>
  </td>
</tr>
