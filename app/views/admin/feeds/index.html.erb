<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Feeds</h2>
  <div>
    <%= button_to "Seed BBC Feeds", seed_admin_feeds_path, method: :post,
          class: "btn btn-outline-secondary me-2" %>
    <%= button_to "Seed NYT Feeds", seed_admin_feeds_path(source: "nyt"), method: :post,
          class: "btn btn-outline-secondary me-2" %>
    <%= button_to "Seed Ad Hoc News Feeds", seed_admin_feeds_path(source: "adhocnews"), method: :post,
          class: "btn btn-outline-secondary me-2" %>
    <%= link_to "New Feed", new_admin_feed_path, class: "btn btn-primary" %>
  </div>
</div>

<% base_params = request.query_parameters.except("page") %>
<div class="mb-3">
  <div class="mb-2">
    <span class="text-muted small me-1">Status:</span>
    <% [
         [ "enabled",  "Enabled",  @enabled_counts[true].to_i ],
         [ "disabled", "Disabled", @enabled_counts[false].to_i ],
         [ "all",      "All",      @enabled_counts.values.sum ]
       ].each do |value, text, count| %>
      <% active = @enabled_filter == value %>
      <%= link_to url_for(base_params.merge("enabled" => value)),
            "aria-pressed": active,
            class: "btn btn-sm me-1 #{active ? 'btn-secondary' : 'btn-outline-secondary'}" do %>
        <%= text %> <span class="badge bg-secondary"><%= count %></span>
      <% end %>
    <% end %>
  </div>

  <% if @source_counts.size > 1 %>
    <%= render "admin/shared/filter_group", label: "Source", param: :source,
          options: @source_counts.keys.sort.map { |source| [ source, source.upcase ] },
          counts: @source_counts %>
  <% end %>

  <div class="mb-2">
    <span class="text-muted small me-1">Category:</span>
    <%= form_with url: admin_feeds_path, method: :get, local: true, class: "d-inline" do %>
      <% base_params.except("category").each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= select_tag :category,
            options_for_select(
              [ [ "All categories (#{@category_counts.values.sum})", "" ] ] +
                @category_counts.keys.sort.map { |category| [ "#{category} (#{@category_counts[category]})", category ] },
              params[:category]
            ),
            onchange: "this.form.requestSubmit()",
            class: "form-select form-select-sm d-inline-block", style: "width: auto;" %>
    <% end %>
  </div>
</div>

<% if @fetch_result %>
  <div class="card mb-3">
    <div class="card-header">Fetch results — <%= @feed.name %></div>
    <div class="card-body">
      <% if @fetch_result[:error] %>
        <p class="text-danger mb-0">Failed: <%= @fetch_result[:error] %></p>
      <% else %>
        <p class="mb-2">
          <span class="badge bg-success">New: <%= @fetch_result[:new_count] %></span>
          <span class="badge bg-primary">Updated: <%= @fetch_result[:updated_count] %></span>
          <span class="badge bg-secondary">Skipped: <%= @fetch_result[:skipped].size %></span>
        </p>
        <% if @fetch_result[:skipped].any? %>
          <div style="max-height: 300px; overflow-y: auto;">
            <table class="table table-sm mb-0">
              <thead><tr><th>Title</th><th>Reason skipped</th></tr></thead>
              <tbody>
                <% @fetch_result[:skipped].each do |item| %>
                  <tr>
                    <td><%= item[:title] %></td>
                    <td class="text-muted"><small><%= item[:reason] %></small></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<table class="table table-hover" data-controller="sortable-table">
  <thead>
    <tr>
      <th data-action="click->sortable-table#sort">Name</th>
      <th data-action="click->sortable-table#sort">URL</th>
      <th data-action="click->sortable-table#sort" data-sort-type="number">Articles</th>
      <th data-action="click->sortable-table#sort" data-sort-type="number">Posted</th>
      <th data-action="click->sortable-table#sort" data-sort-type="number">Posted %</th>
      <th data-action="click->sortable-table#sort" data-sort-type="number">Schedule</th>
      <th data-action="click->sortable-table#sort" data-sort-type="number">Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "feed", collection: @feeds,
          locals: { telegram_posts_counts_by_feed_id: @telegram_posts_counts_by_feed_id } %>
  </tbody>
</table>
