<%= form_with model: [:admin, feed], class: "needs-validation" do |f| %>
  <% feed.errors.full_messages.each do |msg| %>
    <div class="alert alert-danger"><%= msg %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :url, class: "form-label" %>
    <%= f.url_field :url, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :category, class: "form-label" %>
    <%= f.text_field :category, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :source, class: "form-label" %>
    <%= f.select :source, Feed::SOURCES, {}, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :fetch_hour, "Scheduled fetch", class: "form-label" %>
    <%= f.select :fetch_hour,
          Feed::FETCH_HOURS.map { |hour| [ format("%02d:00", hour), hour ] },
          { include_blank: "Disabled — never auto-fetched" },
          class: "form-select" %>
    <div class="form-text">
      Hour of day (server time) when cron auto-fetches this feed. Disabled by default.
    </div>
  </div>
  <div class="mb-3">
    <%= f.label :autopost_target_channel_ids, "Autopost to", class: "form-label d-block" %>
    <% autopost_channel_choices = TelegramChannel.order(:name).to_a %>
    <% if autopost_channel_choices.empty? %>
      <div class="text-muted small">No channels yet — add one under Channels.</div>
    <% else %>
      <%= f.collection_check_boxes :autopost_target_channel_ids, autopost_channel_choices, :id, :display_name do |choice| %>
        <div class="form-check">
          <%= choice.check_box class: "form-check-input" %>
          <%= choice.label class: "form-check-label" %>
        </div>
      <% end %>
    <% end %>
    <div class="form-text">
      Channels (Telegram, Bale, or any other Telegram-compatible provider) this
      feed's translations autopost to once a translation completes. Each channel
      must also be enabled with its own Autopost toggle on for delivery to
      actually happen. None by default.
    </div>
  </div>
  <div class="form-check mb-3">
    <%= f.check_box :enabled, class: "form-check-input" %>
    <%= f.label :enabled, class: "form-check-label" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_feeds_path, class: "btn btn-outline-secondary ms-2" %>
<% end %>
