<!DOCTYPE html>
<html lang="<%= english_edition? ? "en" : "fa" %>" dir="<%= english_edition? ? "ltr" : "rtl" %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="<%= content_for(:robots).presence || "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" %>">
  <meta name="theme-color" content="#dd3333">

  <% default_description = english_edition? ?
       "The latest world news — automatically rewritten and translated into Persian and English." :
       "آخرین اخبار جهان به فارسی — ترجمه و بازنویسی خودکار خبرهای رسانه‌های معتبر جهان." %>
  <% page_title       = content_for(:title).presence || news_ui(:site_name) %>
  <% page_description = content_for(:description).presence || default_description %>
  <% canonical_url    = content_for(:canonical).presence || request.original_url %>
  <% og_image         = content_for(:og_image).presence %>
  <%# Pages without their own image fall back to the site icon so every share
      still carries a thumbnail (small "summary" card rather than a large one). %>
  <% has_lead_image   = og_image.present? %>
  <% og_image       ||= "#{request.base_url}/icon.png" %>

  <title><%= page_title %></title>
  <meta name="description" content="<%= page_description %>">
  <link rel="canonical" href="<%= canonical_url %>">
  <link rel="sitemap" type="application/xml" href="<%= sitemap_url %>">
  <link rel="alternate" type="application/rss+xml" title="<%= news_ui(:site_name) %> — <%= news_ui(:rss_title) %>" href="<%= news_feed_url %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%# hreflang alternates for bilingual editions %>
  <link rel="alternate" hreflang="fa" href="<%= english_edition? ? request.base_url + lang_switch_url : canonical_url %>">
  <link rel="alternate" hreflang="en" href="<%= english_edition? ? canonical_url : request.base_url + lang_switch_url %>">
  <link rel="alternate" hreflang="x-default" href="<%= request.base_url %>/">

  <%# Open Graph / Twitter %>
  <meta property="og:site_name" content="<%= news_ui(:site_name) %>">
  <meta property="og:locale" content="<%= english_edition? ? "en_GB" : "fa_IR" %>">
  <meta property="og:locale:alternate" content="<%= english_edition? ? "fa_IR" : "en_GB" %>">
  <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
  <meta property="og:title" content="<%= page_title %>">
  <meta property="og:description" content="<%= page_description %>">
  <meta property="og:url" content="<%= canonical_url %>">
  <meta property="og:image" content="<%= og_image %>">
  <meta property="og:image:alt" content="<%= page_title %>">
  <%= yield :og_article_meta %>
  <meta name="twitter:card" content="<%= has_lead_image ? "summary_large_image" : "summary" %>">
  <meta name="twitter:title" content="<%= page_title %>">
  <meta name="twitter:description" content="<%= page_description %>">
  <meta name="twitter:image" content="<%= og_image %>">
  <meta name="twitter:image:alt" content="<%= page_title %>">

  <%# Organization JSON-LD (site-wide identity for Knowledge Graph) %>
  <script type="application/ld+json">
    <%= raw({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: news_ui(:site_name),
      url: root_url,
      logo: {
        "@type": "ImageObject",
        url: "#{request.base_url}/icon.png"
      },
      sameAs: []
    }.to_json) %>
  </script>

  <%= yield :head %>

  <%# Resource hints — keep CDN connections warm for first paint %>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <% if english_edition? %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <% else %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.rtl.min.css" rel="stylesheet"
          integrity="sha384-CfCrinSRH2IR6a4e6fy2q6ioOX7O6Mtm1L9vRvFZ1trBncWmMePhzvafv7oIcWiW" crossorigin="anonymous">
  <% end %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet"
        integrity="sha384-CK2SzKma4jA5H/MXDUU7i1TqZlCFaD4T01vtyDFvPlD97JQyS+IsSh1nI2EFbpyk" crossorigin="anonymous">
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css">

  <style>
    :root { --accent: #dd3333; --ink: #222; --muted: #777; --line: #e6e6e6; }
    * { box-sizing: border-box; }
    body { font-family: "Vazirmatn", system-ui, sans-serif; color: var(--ink); background: #fff; line-height: 1.85; }
    a { text-decoration: none; color: inherit; }

    /* ── Top bar ─────────────────────────────────────────────── */
    .topbar { background: #f7f7f7; border-bottom: 1px solid var(--line); font-size: .8rem; color: var(--muted); }
    .topbar a { color: var(--muted); }
    .topbar a:hover { color: var(--accent); }
    .topbar .social a { margin-inline-start: 12px; font-size: .9rem; }

    /* ── Logo (lives in the top bar) ─────────────────────────── */
    /* Three columns: date | centred logo | language + social */
    .topbar-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
    .topbar-row .date { justify-self: start; }
    .topbar-row .social { justify-self: end; }
    .topbar .logo-box { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
    .topbar .logo-box:hover { color: var(--ink); }
    .logo-mark { width: 36px; height: 36px; border-radius: 8px; display: block; }
    .logo-text { font-size: 1.4rem; font-weight: 800; line-height: 1; }
    .logo-text small { color: var(--accent); }

    /* ── Feed stories bar ────────────────────────────────────── */
    .feed-stories { border-block: 1px solid var(--line); background: #fff; }
    .feed-stories ul {
      list-style: none; margin: 0; padding: 12px 0; display: flex; gap: 16px;
      overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none;
    }
    .feed-stories ul::-webkit-scrollbar { display: none; }
    .feed-story.posted .ring { background: conic-gradient(#229ed9, #5ec8f2, #229ed9); }
    .feed-story.posted .avatar { font-size: 1.6rem; }
    .feed-story.posted.seen .ring { background: #cfd3d8; }
    .feed-story {
      flex: 0 0 auto; width: 72px; text-align: center; display: block; color: var(--ink);
      background: none; border: 0; padding: 0; font: inherit; cursor: pointer;
    }
    .feed-story .ring {
      width: 64px; height: 64px; margin: 0 auto 6px; border-radius: 50%; padding: 3px; display: flex;
      background: conic-gradient(var(--cat), var(--accent), var(--cat));
    }
    .feed-story.seen .ring { background: #cfd3d8; }
    .feed-story:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 8px; }
    .feed-story .avatar {
      flex: 1; border-radius: 50%; border: 2px solid #fff; background: var(--cat); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: .8rem; letter-spacing: -.02em;
    }
    .feed-story .label {
      display: block; font-size: .72rem; line-height: 1.25; font-weight: 600;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* ── Story viewer (full-screen, Instagram-style) ────────── */
    .story-viewer[hidden] { display: none; }
    .story-viewer {
      position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,.92);
      display: flex; align-items: center; justify-content: center;
    }
    .story-frame {
      position: relative; width: 100%; height: 100%; max-width: 440px; max-height: 100dvh;
      background: #111; color: #fff; overflow: hidden;
    }
    @media (min-width: 600px) { .story-frame { height: min(100dvh, 780px); border-radius: 14px; } }
    .story-progress { position: absolute; top: 8px; inset-inline: 10px; z-index: 4; display: flex; gap: 4px; }
    .story-progress span { flex: 1; height: 3px; border-radius: 2px; background: rgba(255,255,255,.3); overflow: hidden; }
    .story-progress i { display: block; height: 100%; width: 0; background: #fff; }
    .story-head {
      position: absolute; top: 18px; inset-inline: 10px; z-index: 4;
      display: flex; align-items: center; justify-content: space-between;
    }
    .story-who { display: flex; align-items: center; gap: 8px; color: #fff; min-width: 0; font-size: .85rem; font-weight: 700; }
    .story-who:hover { color: #fff; }
    .story-avatar {
      flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%; background: var(--cat);
      display: flex; align-items: center; justify-content: center; font-size: .65rem; font-weight: 800;
      border: 2px solid #fff;
    }
    .story-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .story-time { font-weight: 400; opacity: .75; white-space: nowrap; }
    .story-close { background: none; border: 0; color: #fff; font-size: 1.2rem; padding: 8px; cursor: pointer; }
    .story-page { position: absolute; inset: 0; background: linear-gradient(160deg, var(--cat), #111 70%); }
    .story-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .story-page::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,.55), transparent 22%, transparent 35%, rgba(0,0,0,.88) 100%);
    }
    .story-text { position: absolute; inset-inline: 0; bottom: 0; z-index: 3; padding: 20px 20px 28px; pointer-events: none; }
    .story-cat { display: inline-block; background: var(--cat); font-size: .72rem; font-weight: 700; padding: 3px 9px; border-radius: 3px; }
    .story-title { font-size: 1.45rem; line-height: 1.4; font-weight: 800; margin: 10px 0 8px; }
    .story-excerpt { font-size: .95rem; line-height: 1.8; opacity: .9; margin: 0 0 16px; }
    .story-read {
      pointer-events: auto; display: inline-block; background: #fff; color: #111; font-weight: 700;
      font-size: .9rem; padding: 9px 18px; border-radius: 999px;
    }
    .story-read:hover { color: #111; }
    .story-zone { position: absolute; top: 70px; bottom: 90px; z-index: 2; background: none; border: 0; padding: 0; cursor: pointer; }
    .story-zone-prev { inset-inline-start: 0; width: 35%; }
    .story-zone-next { inset-inline-end: 0; width: 65%; }

    /* ── Main menu ───────────────────────────────────────────── */
    .mainmenu { background: var(--ink); }
    .mainmenu > .container { display: flex; align-items: stretch; flex-wrap: wrap; column-gap: 12px; }
    .mainmenu .menu-list {
      list-style: none; margin: 0; padding: 0; flex: 0 1 auto;
      display: flex; justify-content: flex-start; align-items: stretch;
      flex-wrap: wrap;
    }
    .mainmenu .menu-list > li { flex: 0 0 auto; }
    .mainmenu .menu-link {
      display: block; color: #fff; font-weight: 700; font-size: .95rem; line-height: 1;
      padding: 15px 18px; white-space: nowrap;
      border-inline-start: 1px solid rgba(255,255,255,.1);
    }
    .mainmenu .menu-list > li:last-child .menu-link { border-inline-end: 1px solid rgba(255,255,255,.1); }
    .mainmenu .menu-link:hover { background: rgba(255,255,255,.1); color: #fff; }
    .mainmenu .menu-link.active { background: var(--accent); color: #fff; }
    .mainmenu .menu-more { position: relative; }
    .mainmenu .menu-more summary { list-style: none; cursor: pointer; }
    .mainmenu .menu-more summary::-webkit-details-marker { display: none; }
    .mainmenu .menu-more summary .bi { font-size: .7em; margin-inline-start: 4px; }
    .mainmenu .menu-more details[open] > summary { background: rgba(255,255,255,.1); }
    .mainmenu .menu-dropdown {
      list-style: none; margin: 0; padding: 6px 0; position: absolute; z-index: 50;
      inset-inline-end: 0; min-width: 190px; background: var(--ink);
      border: 1px solid rgba(255,255,255,.15); box-shadow: 0 8px 20px rgba(0,0,0,.3);
    }
    .mainmenu .dropdown-link { display: block; color: #fff; padding: 10px 18px; font-size: .9rem; white-space: nowrap; }
    .mainmenu .dropdown-link:hover { background: rgba(255,255,255,.1); color: #fff; }
    .mainmenu .dropdown-link.active { background: var(--accent); }
    @media (max-width: 575px) {
      .mainmenu .menu-list { justify-content: flex-start; }
      .mainmenu .menu-link { padding: 13px 14px; font-size: .9rem; }
      .mainmenu .menu-dropdown { inset-inline-end: auto; inset-inline-start: 0; }
    }

    /* ── Section headers ─────────────────────────────────────── */
    .block-title { font-weight: 800; font-size: 1.15rem; margin: 0 0 18px;
                   border-bottom: 2px solid var(--cat, var(--ink)); padding-bottom: 6px; position: relative;
                   display: flex; justify-content: space-between; align-items: flex-end; }
    .block-title span { background: var(--cat, var(--accent)); color: #fff; padding: 4px 12px; display: inline-block;
                        margin-bottom: -2px; }
    .block-title .more { font-size: .78rem; font-weight: 700; color: var(--muted); padding-bottom: 2px; }
    .block-title .more:hover { color: var(--cat, var(--accent)); }

    /* ── Category label (overlaid on images) ─────────────────── */
    .cat-label { display: inline-block; background: var(--cat, var(--accent)); color: #fff; font-size: .72rem;
                 font-weight: 700; padding: 3px 9px; text-transform: uppercase; }
    .cat-label.flat { background: transparent; color: var(--cat, var(--accent)); padding: 0; }

    /* ── Overlay (hero / featured) cards ─────────────────────── */
    .overlay-card { position: relative; overflow: hidden; display: block; height: 100%; min-height: 220px; background: #111; }
    .overlay-card img { width: 100%; height: 100%; object-fit: cover; opacity: .82; transition: transform .4s, opacity .2s; }
    .overlay-card:hover img { transform: scale(1.05); opacity: .7; }
    .overlay-card .overlay-body { position: absolute; inset-inline: 0; bottom: 0; padding: 18px 18px 16px;
      background: linear-gradient(to top, rgba(0,0,0,.85), rgba(0,0,0,0)); color: #fff; }
    .overlay-card .overlay-title { color: #fff; font-weight: 800; line-height: 1.5; margin: 8px 0 4px; }
    .overlay-card.hero { min-height: 460px; }
    .overlay-card.hero .overlay-title { font-size: 1.7rem; }
    .overlay-card.tile { min-height: 150px; }
    .overlay-card.tile .overlay-title { font-size: .98rem; margin: 4px 0 2px; }
    .overlay-card .meta { color: #d8d8d8; font-size: .78rem; }

    /* ── Mosaic hero (big grid) ──────────────────────────────── */
    .mosaic { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr);
              grid-template-rows: repeat(2, 1fr); grid-auto-rows: 1fr; }
    .mosaic .lead { grid-column: 1 / 2; grid-row: 1 / 3; }
    @media (max-width: 767px) {
      .mosaic { grid-template-columns: 1fr; gap: 8px; }
      .mosaic .lead { grid-column: auto; grid-row: auto; }
    }

    /* ── List items (thumb + text) ───────────────────────────── */
    .post-item { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .post-item .thumb { flex: 0 0 110px; height: 80px; overflow: hidden; background: #eee; }
    .post-item .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .post-item:hover .thumb img { transform: scale(1.06); }
    .post-item .post-title { font-weight: 700; font-size: 1.02rem; line-height: 1.6; margin: 4px 0; }
    .post-item:hover .post-title { color: var(--cat, var(--accent)); }
    .post-item .meta { color: var(--muted); font-size: .78rem; }
    .post-item .excerpt { color: #555; font-size: .9rem; margin-top: 4px; }

    /* ── Category module: big lead post + side list ──────────── */
    .module-lead { display: block; margin-bottom: 4px; }
    .module-lead .lead-figure { overflow: hidden; background: #eee; aspect-ratio: 16 / 9; }
    .module-lead .lead-figure img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .module-lead:hover .lead-figure img { transform: scale(1.04); }
    .module-lead .lead-title { font-weight: 800; font-size: 1.3rem; line-height: 1.6; margin: 10px 0 4px; }
    .module-lead:hover .lead-title { color: var(--cat, var(--accent)); }
    .module-lead .excerpt { color: #555; font-size: .95rem; margin-top: 6px; }
    .module-lead .meta { color: var(--muted); font-size: .78rem; }

    /* ── Sidebar ─────────────────────────────────────────────── */
    .sidebar .post-item .thumb { flex-basis: 80px; height: 60px; }
    .sidebar .post-title { font-size: .92rem; }
    .cat-list a { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--line); font-weight: 700; }
    .cat-list a:hover { color: var(--accent); }
    .cat-list .count { background: #eee; color: #555; border-radius: 3px; padding: 0 8px; font-size: .8rem; font-weight: 700; }

    /* ── Article (show) ──────────────────────────────────────── */
    .article-figure img { width: 100%; border-radius: 0; }
    .article-body { font-size: 1.13rem; color: #1a1a1a; }
    .article-body p { margin-bottom: 1.1rem; }
    .article-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .tags-label { color: var(--muted); font-weight: 700; font-size: .85rem; }
    .tag-chip { background: #f0f0f0; border: 1px solid var(--line); border-radius: 999px; padding: 3px 12px; font-size: .85rem; }
    .tag-chip:hover { border-color: var(--accent); color: var(--accent); }
    .tag-chip.tag-feed { color: var(--ink); font-weight: 600; text-decoration: none; }

    .skip-link { position: absolute; top: 0; inset-inline-start: 0; z-index: 2000; background: #fff; padding: 8px 14px; }

    /* ── Share bar ───────────────────────────────────────────── */
    .share-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .share-bar .share-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line);
      background: #fff; color: var(--ink); border-radius: 999px; padding: 4px 12px; font-size: .85rem;
      font-family: inherit; cursor: pointer; }
    .share-bar .share-btn:hover { border-color: var(--cat, var(--accent)); color: var(--cat, var(--accent)); }

    /* ── Not-found (404 / unpublished) page ──────────────────── */
    .not-found { max-width: 460px; margin-inline: auto; }
    .not-found-icon { position: relative; display: inline-block; font-size: 3.4rem; color: var(--accent); }
    .not-found-icon .bi-emoji-dizzy { position: absolute; top: -6px; inset-inline-end: -20px; font-size: 1.5rem;
      color: var(--ink); background: #fff; border-radius: 50%; box-shadow: 0 0 0 2px #fff; }
    .not-found-title { font-weight: 800; font-size: 1.8rem; margin: 18px 0 10px; }
    .not-found-body { color: var(--muted); font-size: 1rem; }

    /* ── Search (inside the main menu bar) ──────────────────── */
    .mainmenu .menu-search { flex: 0 0 240px; margin: 6px 0; margin-inline-start: auto; }
    .mainmenu .menu-search form { display: flex; margin: 0; }
    .mainmenu .menu-search input[type=search] {
      flex: 1; min-width: 0; border: 1px solid rgba(255,255,255,.25); border-inline-end: 0;
      border-start-start-radius: 3px; border-end-start-radius: 3px;
      background: rgba(255,255,255,.08); color: #fff; padding: 6px 12px;
      font-family: inherit; font-size: .85rem; outline: none;
    }
    .mainmenu .menu-search input[type=search]::placeholder { color: rgba(255,255,255,.6); }
    .mainmenu .menu-search input[type=search]:focus { border-color: var(--accent); background: rgba(255,255,255,.14); }
    .mainmenu .menu-search button {
      background: var(--accent); color: #fff; border: 0; padding: 6px 12px; cursor: pointer;
      border-start-end-radius: 3px; border-end-end-radius: 3px;
    }
    .mainmenu .menu-search button:hover { background: #b82a2a; }

    /* ── Footer ──────────────────────────────────────────────── */
    .site-footer { background: #111; color: #bbb; margin-top: 40px; }
    .site-footer a { color: #bbb; }
    .site-footer a:hover { color: #fff; }
    .footer-bottom { background: #000; color: #888; font-size: .82rem; }

    /* ── Mobile overrides ────────────────────────────────────── */
    @media (max-width: 575px) {
      /* Top bar: logo + language toggle only */
      .topbar .date { visibility: hidden; } /* keeps the grid cell so the logo stays centred */
      .logo-text { font-size: 1.2rem; }
      .logo-mark { width: 30px; height: 30px; }

      /* Search drops under the menu, full width */
      .mainmenu .menu-search { flex: 1 0 100%; margin: 0 0 8px; }

      /* Hero card height reduced on small screens */
      .overlay-card.hero { min-height: 280px; }
      .overlay-card.hero .overlay-title { font-size: 1.15rem; }
      .overlay-card.tile { min-height: 130px; }
      .overlay-card.tile .overlay-title { font-size: .9rem; }

      /* Topbar: hide social icons, show only lang toggle */
      .topbar .social .bi { display: none; }
      .topbar .social a[aria-label] { display: none; }

      /* Post-item thumbnail slightly smaller */
      .post-item .thumb { flex-basis: 90px; height: 66px; }
      .post-item .post-title { font-size: .95rem; }

      /* Module lead: smaller title */
      .module-lead .lead-title { font-size: 1.1rem; }

      /* Article body: comfortable reading size */
      .article-body { font-size: 1.05rem; }

      /* Block title smaller */
      .block-title { font-size: 1rem; }

      /* Menu items a bit more compact */
      .mainmenu .menu-link { padding: 11px 12px; font-size: .85rem; }

      /* Container padding tighter on phone */
      .container { padding-inline: 12px; }
    }

    @media (max-width: 767px) {
      /* Sidebar stacks below main content — add top separator */
      .sidebar { border-top: 2px solid var(--line); padding-top: 24px; margin-top: 8px; }
    }
  </style>
</head>
<body>
  <a class="visually-hidden-focusable skip-link" href="#main-content"><%= news_ui(:skip_to_content) %></a>
  <%# ── Top bar: logo, date, language, social ────────────────── %>
  <div class="topbar">
    <div class="container topbar-row py-1">
      <span class="date"><i class="bi bi-calendar3"></i>
        <%= english_edition? ? Date.current.strftime("%d %B %Y") : jalali_date_string(Date.current) %>
      </span>
      <%= link_to home_path, class: "logo-box" do %>
        <%= image_tag "/logo.png", alt: "", class: "logo-mark", width: 36, height: 36 %>
        <span class="logo-text"><%= english_edition? ? "World News" : "خبر فارسی" %><small>.</small></span>
      <% end %>
      <span class="social">
        <%= link_to news_ui(:switch_label), lang_switch_url, class: "fw-bold me-3", rel: "alternate" %>
        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
        <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
        <a href="#" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
        <a href="<%= news_feed_path %>" aria-label="RSS" rel="alternate" type="application/rss+xml"><i class="bi bi-rss"></i></a>
      </span>
    </div>
  </div>

  <%= render "news/feed_stories" if @story_feeds.present? || @posted_story_pages.present? %>

  <%# ── Main menu ────────────────────────────────────────────── %>
  <nav class="mainmenu">
    <div class="container">
      <ul class="menu-list">
        <li>
          <%= link_to news_ui(:home), home_path, class: "menu-link #{'active' if current_page?(home_path)}" %>
        </li>
        <% primary_nav_categories.each do |slug, name| %>
          <li>
            <%= link_to name, category_path(category: slug),
                  class: "menu-link #{'active' if @category == slug}" %>
          </li>
        <% end %>
        <% overflow_categories = overflow_nav_categories %>
        <% if overflow_categories.any? %>
          <li class="menu-more">
            <details>
              <summary class="menu-link <%= 'active' if overflow_categories.any? { |slug, _| @category == slug } %>">
                <%= news_ui(:menu_more) %> <i class="bi bi-chevron-down" aria-hidden="true"></i>
              </summary>
              <ul class="menu-dropdown">
                <% overflow_categories.each do |slug, name| %>
                  <li><%= link_to name, category_path(category: slug),
                            class: "dropdown-link #{'active' if @category == slug}" %></li>
                <% end %>
              </ul>
            </details>
          </li>
        <% end %>
      </ul>
      <div class="menu-search" role="search">
        <%= form_with url: news_search_path, method: :get, local: true do |f| %>
          <%= f.search_field :q,
                value: params[:q],
                placeholder: news_ui(:search_placeholder),
                autocomplete: "off",
                "aria-label": news_ui(:search_label) %>
          <button type="submit" aria-label="<%= news_ui(:search_label) %>"><i class="bi bi-search" aria-hidden="true"></i></button>
        <% end %>
      </div>
    </div>
  </nav>

  <%# ── Body: main + sidebar ─────────────────────────────────── %>
  <div class="container py-4">
    <div class="row g-4">
      <main id="main-content" class="col-md-8"><%= yield %></main>
      <aside class="col-md-4 sidebar"><%= render "news/sidebar" %></aside>
    </div>
  </div>

  <%# ── Footer ───────────────────────────────────────────────── %>
  <footer class="site-footer pt-4">
    <div class="container">
      <div class="row gy-3">
        <div class="col-md-5">
          <div class="logo-box mb-2">
            <%= image_tag "/logo.png", alt: "", class: "logo-mark", width: 44, height: 44 %>
            <span class="logo-text" style="font-size:1.4rem;color:#fff"><%= english_edition? ? "Khabarestan" : "خبرستان" %></span>
          </div>
          <p class="small"><%= news_ui(:tagline) %></p>
        </div>
        <div class="col-md-4">
          <h6 class="text-white fw-bold mb-3"><%= news_ui(:sections) %></h6>
          <div class="d-flex flex-wrap gap-3">
            <% nav_categories.each do |slug, name| %>
              <%= link_to name, category_path(category: slug), class: "small" %>
            <% end %>
          </div>
        </div>
        <div class="col-md-3">
          <h6 class="text-white fw-bold mb-3"><%= news_ui(:follow) %></h6>
          <a href="#" class="me-2"><i class="bi bi-instagram"></i></a>
          <a href="#" class="me-2"><i class="bi bi-twitter-x"></i></a>
          <a href="#" class="me-2"><i class="bi bi-telegram"></i></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom mt-4 py-3">
      <div class="container">© <%= Date.current.year %> <%= news_ui(:site_name) %></div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
