<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Khabarestan API</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <style>
    body { background: #f8f9fa; }
    .stat-value { font-size: 1.8rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .stat-label { font-size: .8rem; color: #6c757d; text-transform: uppercase; letter-spacing: .03em; }
    .day-bar { background: #0d6efd; border-radius: 3px 3px 0 0; min-height: 2px; }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand d-flex align-items-center">
        <img src="/logo.png" alt="" width="28" height="28" class="rounded me-2">Khabarestan API
      </span>
    </div>
  </nav>
  <main class="container pb-5"><%= yield %></main>
</body>
</html>
