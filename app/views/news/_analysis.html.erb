<%# AI analysis of the ORIGINAL article (see ArticleAnalyzer): political
    leaning and factual/speculative split as stacked bars, plus the reasoning
    in the edition's language. Rendered only for analyzed articles.
    Locals: article %>
<% reasoning_text, reasoning_lang = analysis_reasoning_for(article) %>
<section class="article-analysis mt-4 pt-3 border-top" aria-labelledby="article-analysis-title">
  <h2 id="article-analysis-title" class="analysis-title"><i class="bi bi-bar-chart-line"></i> <%= news_ui(:analysis_title) %></h2>

  <% [ [ :leaning, news_ui(:analysis_leaning) ], [ :nature, news_ui(:analysis_nature) ] ].each do |bar_kind, bar_label| %>
    <% segments = analysis_bar_segments(article, bar_kind) %>
    <div class="analysis-row">
      <div class="analysis-label"><%= bar_label %></div>
      <div class="analysis-bar" role="img"
           aria-label="<%= segments.map { |_modifier, label, percent| "#{label} #{percent}%" }.join(", ") %>">
        <% segments.each do |modifier, label, percent| %>
          <span class="analysis-segment analysis-<%= modifier %>" style="width: <%= percent %>%"
                title="<%= label %> <%= percent %>%"></span>
        <% end %>
      </div>
      <div class="analysis-legend">
        <% segments.each do |modifier, label, percent| %>
          <span><i class="analysis-dot analysis-<%= modifier %>"></i><%= label %>
            <%= english_edition? ? "#{percent}%" : "#{to_persian_digits(percent)}٪" %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if reasoning_text.present? %>
    <p class="analysis-reasoning" lang="<%= reasoning_lang %>" dir="<%= reasoning_lang == "fa" ? "rtl" : "ltr" %>"><%= reasoning_text %></p>
  <% end %>
  <p class="analysis-note"><%= news_ui(:analysis_note) %></p>
</section>
